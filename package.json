{
  "name": "@recruiteros/recruit-ui",
  "version": "0.20.1",
  "description": "Public, slot-driven recruiting workflow components for React.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RecruiterOS/recruit-ui.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./core/*": {
      "import": {
        "types": "./dist/core/*.d.ts",
        "default": "./dist/core/*.js"
      },
      "require": {
        "types": "./dist/core/*.d.cts",
        "default": "./dist/core/*.cjs"
      }
    },
    "./recruit": {
      "import": {
        "types": "./dist/recruit/index.d.ts",
        "default": "./dist/recruit/index.js"
      },
      "require": {
        "types": "./dist/recruit/index.d.cts",
        "default": "./dist/recruit/index.cjs"
      }
    },
    "./recruit/*": {
      "import": {
        "types": "./dist/recruit/*.d.ts",
        "default": "./dist/recruit/*.js"
      },
      "require": {
        "types": "./dist/recruit/*.d.cts",
        "default": "./dist/recruit/*.cjs"
      }
    }
  },
  "scripts": {
    "build": "pnpm check:imports && pnpm build:package && pnpm check:client-boundaries && pnpm check:package-consumers && pnpm build:registry",
    "build:package": "tsup && node scripts/preserve-client-boundaries.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:registry": "node scripts/validate-registry.mjs",
    "validate:shadcn": "shadcn registry validate",
    "check:registry": "node scripts/check-registry.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:client-boundaries": "node scripts/check-client-boundaries.mjs",
    "check:package-consumers": "node scripts/check-package-consumers.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:empty-states": "node scripts/check-empty-states.mjs",
    "check:public": "node scripts/public-safety.mjs",
    "verify": "pnpm check:imports && pnpm check:public && pnpm check:empty-states && pnpm typecheck && pnpm test && pnpm check:dist && pnpm validate:registry && pnpm validate:shadcn && pnpm check:registry && pnpm check:public",
    "prepublishOnly": "pnpm verify"
  },
  "peerDependencies": {
    "@epicbagel/saas-kit": "^1.16.0",
    "lucide-react": ">=0.400.0 <2",
    "react": ">=18.2 <20",
    "react-dom": ">=18.2 <20"
  },
  "devDependencies": {
    "@epicbagel/saas-kit": "1.16.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "lucide-react": "0.400.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "4.22.1",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
